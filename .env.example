NEXT_PUBLIC_SITE_URL=https://ufms-help.ru
DATA_DIR=/data
KNOWLEDGE_DB_PATH=/data/knowledge.db
AI_CHAT_LOG_DB_PATH=/data/ai-chat-log.db
AI_CHAT_LOG_RETENTION_DAYS=60
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql://payload:password@localhost:5432/fms3
PAYLOAD_SECRET=replace-with-a-random-secret-at-least-32-characters

# Payload password-reset email. Fill these from your SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Миграционный справочник

JWT_SECRET=replace-with-a-long-random-secret
RATE_LIMIT_SECRET=replace-with-another-long-random-secret
ADMIN_SECRET=replace-with-a-separate-long-admin-secret
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

PRAVOVED_REFERRAL_ID=
PRAVOVED_SECRET=
